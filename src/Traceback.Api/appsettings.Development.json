{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "GitHub": {
    // The token comes from user secrets or the environment (GitHub__Token),
    // never from a file in source control. See docs/integrations/github.md.
    // "TokenFile": "/run/secrets/github_token",
    "ApiBaseUrl": "https://api.github.com/",
    "InitialLookbackDays": 30,
    "IncrementalOverlapDays": 7,
    "PageSize": 100,
    "Repositories": [
      {
        "Owner": "your-org",
        "Name": "your-repo",
        "InitialLookbackDays": 30
      }
    ]
  }
}
