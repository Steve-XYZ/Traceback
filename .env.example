# Copy to .env and fill in. .env is git-ignored; never commit a real token.
#
# Read-only GitHub credentials for the connector. Prefer a fine-grained
# personal access token limited to the repositories you want to synchronize,
# with Metadata: Read-only, Contents: Read-only, Pull requests: Read-only and
# Actions: Read-only. No write permission is ever used.
# See docs/integrations/github.md.
GITHUB_TOKEN=

# The repository to synchronize, e.g. GITHUB_OWNER=acme GITHUB_REPO=player-manager
GITHUB_OWNER=
GITHUB_REPO=

# History depth of the first synchronization, in days.
GITHUB_INITIAL_LOOKBACK_DAYS=30
